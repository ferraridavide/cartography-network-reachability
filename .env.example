# Neo4j instance populated by Cartography (https://github.com/cartography-cncf/cartography)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Optional: leave empty to use the server's default database
NEO4J_DATABASE=

# Optional defaults used by the MCP server (the CLI takes flags instead)
# REACHABILITY_SOURCE_FILTER=
# REACHABILITY_DESTINATION_FILTER=
# REACHABILITY_SOURCE_LIMIT=0
# REACHABILITY_PAIR_LIMIT=0
# REACHABILITY_PATH_LIMIT=0
